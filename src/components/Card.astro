---
interface Props {
  title: string;
  description: string;
  link: string;
  imageUrl?: string;
  badgeType?: 'news' | 'ad' | 'promo';
}
const { title, description, link, imageUrl, badgeType } = Astro.props;
const badgeColors = { news: '#3b82f6', ad: '#ef4444', promo: '#10b981' };
---
<article class="card">
  {imageUrl && <img src={imageUrl} alt={title} class="card-image" />}
  <div class="card-content">
    {badgeType && (
      <span class="badge" style={`background-color: ${badgeColors[badgeType]}`}>
        {badgeType.toUpperCase()}
      </span>
    )}
    <h3>{title}</h3>
    <p>{description}</p>
    <a href={link} class="card-btn">Learn More</a>
  </div>
</article>
<style>
  .card { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; background: #ffffff; display: flex; flex-direction: column; max-width: 320px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: transform 0.2s ease; }
  .card:hover { transform: translateY(-4px); }
  .card-image { width: 100%; height: 160px; object-fit: cover; }
  .card-content { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
  .badge { align-self: flex-start; color: white; font-size: 0.75rem; font-weight: bold; padding: 0.25rem 0.5rem; border-radius: 4px; margin-bottom: 0.5rem; }
  h3 { margin: 0 0 0.5rem 0; font-size: 1.25rem; color: #111827; }
  p { color: #4b5563; font-size: 0.875rem; margin-bottom: 1.5rem; flex-grow: 1; }
  .card-btn { text-align: center; background: #111827; color: #ffffff; text-decoration: none; padding: 0.5rem; border-radius: 4px; font-weight: 500; }
</style>
